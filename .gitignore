# ============================================
# QuietSpace — .gitignore
# ============================================

# ── Environment Variables (NEVER commit) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# ── Node / Frontend ──
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# ── Python / Backend ──
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
venv/
backend/venv/
env/
.env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── IDE / Editor ──
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Vercel ──
.vercel/

# ── Coverage ──
coverage/
htmlcov/
.coverage
